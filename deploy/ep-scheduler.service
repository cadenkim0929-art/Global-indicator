# deploy/ep-scheduler.service
#
# 뉴스 수집/지표 갱신을 자동 실행하는 scripts/scheduler.mjs를 systemd 서비스로
# 등록하기 위한 템플릿. `next start`(웹앱 본체)와는 별개의 프로세스로 떠서,
# 웹앱을 재배포/재시작해도 스케줄러는 계속 살아있고(또는 반대로 스케줄러만
# 따로 재시작 가능), 죽으면 systemd가 자동으로 재기동한다.
#
# 설치 방법 (서버에서):
#   1) 아래 경로/사용자명을 실제 배포 경로에 맞게 수정
#   2) sudo cp deploy/ep-scheduler.service /etc/systemd/system/ep-scheduler.service
#   3) sudo systemctl daemon-reload
#   4) sudo systemctl enable --now ep-scheduler
#   5) 로그 확인: sudo journalctl -u ep-scheduler -f
#
# COLLECT_SECRET / INDICATORS_SECRET은 이 파일에 직접 쓰지 말고, EnvironmentFile로
# /home/ubuntu/.hermes/secrets/ 아래 별도 파일을 가리키게 하는 걸 권장
# (프로젝트 기존 관례: 시크릿은 항상 별도 파일, 하드코딩 금지).

[Unit]
Description=EP Industry Monitor - 뉴스 수집/지표 갱신 스케줄러
After=network.target ep-industry-monitor-web.service
Wants=ep-industry-monitor-web.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.openclaw/workspace/ep-industry-monitor-web
ExecStart=/usr/bin/node scripts/scheduler.mjs
Restart=always
RestartSec=10

# 웹앱이 localhost:3000이 아닌 다른 포트/도메인이면 여기서 조정
Environment=SCHEDULER_BASE_URL=http://127.0.0.1:8766
Environment=SCHEDULER_TIMEZONE=Asia/Seoul
# 기본 스케줄: 뉴스 수집 매일 07:00/12:00/18:00 KST, 지표 갱신 매일 06:50 KST — 필요시 조정
Environment="SCHEDULER_COLLECT_CRON=0 7,12,18 * * *"
Environment="SCHEDULER_INDICATORS_CRON=50 6 * * *"

# 시크릿은 파일로 분리 (예: /home/ubuntu/.hermes/secrets/ep-scheduler.env)
# 파일 내용 예시:
#   COLLECT_SECRET=xxxxxxxx
#   INDICATORS_SECRET=yyyyyyyy
EnvironmentFile=-/home/ubuntu/.hermes/secrets/ep-scheduler.env

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
